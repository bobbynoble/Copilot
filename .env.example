# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# camb.ai API Key — get yours at https://studio.camb.ai (API section)
# Required for the NHS Translation Bot (translation, TTS, dubbing)
CAMB_API_KEY=your-camb-api-key-here

# ElevenLabs API Key — get yours at https://elevenlabs.io (Profile > API Keys)
# Required for the ElevenLabs variant of the NHS Translation Bot (nhs_elevenlabs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Optional: API key to protect the RFP agent endpoints (used in X-API-Key header)
# Leave empty to disable endpoint authentication
RFP_API_KEY=your-secret-key-here

# Optional: allowed CORS origins (comma-separated)
# Defaults to "*" which allows Copilot Studio and other callers
CORS_ORIGINS=*
