# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Optional: API key to protect the RFP agent endpoints (used in X-API-Key header)
# Leave empty to disable endpoint authentication
RFP_API_KEY=your-secret-key-here

# Optional: allowed CORS origins (comma-separated)
# Defaults to "*" which allows Copilot Studio and other callers
CORS_ORIGINS=*
